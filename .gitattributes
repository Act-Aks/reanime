# Normalize text across developer platforms; preserve official binary artifacts.
* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sh text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

*.jar binary
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
